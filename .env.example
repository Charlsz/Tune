# Copiar a `.env` y ajustar. `.env` NO se commitea.

# --- MLflow ---
# Dentro de docker compose los servicios se hablan por nombre: http://mlflow:5000
# Desde la máquina host (fuera de Docker): http://localhost:5000
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=tune
MLFLOW_PORT=5000

# --- API de inferencia ---
API_HOST=0.0.0.0
API_PORT=8000
# Nombre del modelo en el Model Registry y alias que sirve la API
TUNE_MODEL_NAME=tune-model
TUNE_MODEL_ALIAS=approved

# --- Rutas (relativas a la raíz del repo; en Docker se montan como volúmenes) ---
TUNE_DATA_DIR=./data
TUNE_CONFIGS_DIR=./configs
TUNE_ARTIFACTS_DIR=./artifacts

# --- Hugging Face (solo si el dataset/modelo lo requiere) ---
HF_TOKEN=
