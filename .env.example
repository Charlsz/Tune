# Terra environment variables
# Copy to .env and adjust paths for your local machine.

# Root directory for datasets (not committed to Git)
TERRA_DATA_ROOT=./data

# HLS Burn Scars dataset location (download from Hugging Face)
# https://huggingface.co/datasets/ibm-nasa-geospatial/hls_burn_scars
BURN_SCARS_DATA_ROOT=${TERRA_DATA_ROOT}/hls_burn_scars

# MLflow tracking URI (local by default)
MLFLOW_TRACKING_URI=./mlruns

# Hugging Face token (optional, for gated models/datasets)
# HF_TOKEN=

# Training output directory
TERRA_OUTPUT_DIR=./output
