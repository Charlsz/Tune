  "cards": [
    {
      "dot": "emerald",
      "title": "Camino de la web",
      "items": [
        "Catálogo y ejemplos responden NDJSON: download, infer, done, con HTTP 200",
        "Un archivo local no pasa por Earth Search y la API responde 201"
      ]
    },
    {
      "dot": "amber",
      "title": "Capas que pueden faltar",
      "items": [
        "JRC se intenta primero; el historial solo entra si JRC no responde",
        "Sin CRS no hay change, fusión ni exposición. Un recorte con más de 90 % de nubes responde 422 antes de execute"
      ]
    }
